<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- The RunicArtifex.DynamicData pair is published on NuGet.org; the shipping
       libraries' packages.lock.json files pin its content hashes. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="RunicArtifex.DynamicData" />
      <package pattern="RunicArtifex.DynamicData.Reactive" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
