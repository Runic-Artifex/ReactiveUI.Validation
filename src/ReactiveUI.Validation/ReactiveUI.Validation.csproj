<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(LibraryTargetFrameworks)</TargetFrameworks>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
    <PackageId>RunicArtifex.ReactiveUI.Validation</PackageId>
    <Title>Runic Artifex fork of ReactiveUI.Validation for ReactiveUI.Primitives</Title>
    <Description>The Runic Artifex fork of ReactiveUI.Validation for .NET 10 and ReactiveUI.Primitives (the ReactiveUI package): validation rules and bindings for ReactiveUI view models, with generated call sites that stay trimming- and NativeAOT-safe.</Description>
    <ValidationNamespaceRoot>ReactiveUI.Validation</ValidationNamespaceRoot>
  </PropertyGroup>

  <Import Project="ReactiveUI.Validation.Usings.props" />

  <ItemGroup>
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="RunicArtifex.DynamicData" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="DynamicData" />
    <Using Include="ReactiveUI.Binding.Expressions" />
    <Using Include="ReactiveUI.Primitives.Concurrency" />
    <Using Include="ReactiveUI.Primitives" />
    <Using Include="ReactiveUI.Primitives.Disposables" />
    <Using Include="ReactiveUI.Primitives.Signals" />
    <Using Include="ReactiveUI.Primitives.Disposables.Scope" Alias="Disposable" />
    <Using Include="ReactiveUI.Primitives.Concurrency.ISequencer" Alias="IScheduler" />
    <Using Include="ReactiveUI.Primitives.Signals.Signal" Alias="Observable" />
    <Using Include="ReactiveUI.Primitives.RxVoid" Alias="Unit" />
    <Using Include="ReactiveUI.Primitives.Disposables.MultipleDisposable" Alias="CompositeDisposable" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ReactiveUI.Validation.Tests" />
    <InternalsVisibleTo Include="ReactiveUI.Validation.AndroidX" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <PackageReference Include="System.Collections.Immutable" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
  </ItemGroup>
</Project>
