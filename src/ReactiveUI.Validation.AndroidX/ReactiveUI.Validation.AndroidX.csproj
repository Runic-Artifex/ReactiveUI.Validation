<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MauiAndroidTargets)</TargetFrameworks>
    <Title>Runic Artifex fork of ReactiveUI.Validation for AndroidX</Title>
    <Description>The Runic Artifex fork of ReactiveUI.Validation for AndroidX: validation extensions for the AndroidX library, for apps that use ReactiveUI.AndroidX.</Description>
    <PackageId>RunicArtifex.ReactiveUI.Validation.AndroidX</PackageId>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>enable</Nullable>
    <ValidationNamespaceRoot>ReactiveUI.Validation</ValidationNamespaceRoot>
  </PropertyGroup>

  <Import Project="..\ReactiveUI.Validation\ReactiveUI.Validation.Usings.props" />

  <ItemGroup>
    <PackageReference Include="ReactiveUI.AndroidX" />
    <PackageReference Include="Xamarin.Google.Android.Material" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReactiveUI.Validation\ReactiveUI.Validation.csproj" />
  </ItemGroup>
</Project>
