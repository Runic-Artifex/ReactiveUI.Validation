<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>GeneratedValidation.LegacyPeer.Reactive</AssemblyName>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);REACTIVE_SHIM</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LegacyCaller.cs" Link="LegacyCaller.cs" />
    <!-- Historical ABI fixture only: the old analyzer must not replace the original normal API IL calls. -->
    <PackageReference Include="Runic.ReactiveUI.Validation.Reactive" Version="8.1.0-runic.0.790.17.15.10" ExcludeAssets="analyzers;build;buildTransitive" />
    <PackageReference Include="ReactiveUI.Reactive" Version="26.0.1" />
    <PackageReference Include="Runic.DynamicData.Reactive" Version="10.0.0-runic.5" />
  </ItemGroup>
  <Target Name="ExcludeOnlyHistoricalValidationAnalyzer" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'ReactiveUI.Validation.SourceGenerators'" />
    </ItemGroup>
  </Target>
  <Import Project="../../../../examples/GeneratedValidation/Directory.Build.targets" />
</Project>
