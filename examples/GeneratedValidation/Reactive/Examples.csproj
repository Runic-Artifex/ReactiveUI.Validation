<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GeneratedValidation.Reactive</AssemblyName>
    <DefineConstants>$(DefineConstants);REACTIVE_SHIM;$(NegativeCase)</DefineConstants>
    <PrecompiledConsumerPath Condition="'$(PrecompiledConsumerPath)' == ''">$(MSBuildThisFileDirectory)Precompiled/bin/Release/net10.0/GeneratedValidation.Precompiled.Reactive.dll</PrecompiledConsumerPath>
    <LegacyPrecompiledConsumerPath Condition="'$(LegacyPrecompiledConsumerPath)' == ''">$(MSBuildThisFileDirectory)../../../eng/verification-fixtures/LegacyPeer/frozen/GeneratedValidation.LegacyPeer.Reactive.dll</LegacyPrecompiledConsumerPath>
    <CapabilityFixtureRoot Condition="'$(CapabilityFixtureRoot)' == ''">$(MSBuildThisFileDirectory)../../../eng/verification-fixtures</CapabilityFixtureRoot>
    <PeerGeneratedCallerAnalyzerPath Condition="'$(PeerGeneratedCallerAnalyzerPath)' == ''">$(MSBuildThisFileDirectory)../../../eng/PeerGeneratedCaller/bin/Release/netstandard2.0/Runic.Validation.PeerGeneratedCaller.dll</PeerGeneratedCallerAnalyzerPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="GeneratedValidation.Precompiled.Reactive" HintPath="$(PrecompiledConsumerPath)" />
    <Reference Include="GeneratedValidation.LegacyPeer.Reactive" HintPath="$(LegacyPrecompiledConsumerPath)" />
    <Compile Remove="../PrecompiledCaller.cs" />
    <Compile Remove="Precompiled/**/*.cs" />
    <Compile Include="$(CapabilityFixtureRoot)/RuleCapabilityScenario.cs" Link="RuleCapabilityScenario.cs" />
    <Compile Include="$(CapabilityFixtureRoot)/ProducerInteropScenario.cs" Link="ProducerInteropScenario.cs" />
    <Compile Include="$(CapabilityFixtureRoot)/ErrorHookScenario.cs" Link="ErrorHookScenario.cs" />
    <Compile Include="$(CapabilityFixtureRoot)/PeerGeneratedCallerScenario.cs" Link="PeerGeneratedCallerScenario.cs" />
    <Compile Include="$(CapabilityFixtureRoot)/BindingCapabilityScenario.cs" Link="BindingCapabilityScenario.cs" />
    <Compile Include="$(CapabilityFixtureRoot)/BindingCapabilityScenario.Types.cs" Link="BindingCapabilityScenario.Types.cs" />
    <Analyzer Include="$(PeerGeneratedCallerAnalyzerPath)" />
    <PackageReference Include="Runic.ReactiveUI.Validation.Reactive" Version="$(ValidationVersion)" />
    <PackageReference Include="ReactiveUI.Reactive" Version="26.0.1" />
    <PackageReference Include="Runic.DynamicData.Reactive" Version="10.0.0-runic.30" />
  </ItemGroup>
</Project>
