<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/ReactiveUI.Validation/ReactiveUI.Validation.csproj" />
    <Compile Include="../Program.cs" Link="Program.cs" />
    <Compile Include="../../CollectionValidation/CollectionValidationRecipe.cs;../../CollectionValidation/RecipeChild.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="$(RunicSdkRoot)/packages/dotnet/Runic.Application.Views/RunicModelContext.cs" Link="Sdk/RunicModelContext.cs" />
    <Compile Include="$(RunicSdkRoot)/packages/dotnet/Runic.Application.Views.ReactiveUI/ReactiveModelContextScheduler.cs" Link="Sdk/ReactiveModelContextScheduler.cs" />
  </ItemGroup>
  <Target Name="RequireSdkSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RunicSdkRoot)' == ''" Text="Pass -p:RunicSdkRoot=/absolute/path/to/runic-sdk to run this opt-in SDK source probe." />
  </Target>
</Project>
