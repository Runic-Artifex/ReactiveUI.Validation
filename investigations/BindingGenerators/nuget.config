<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Override feed paths when feeds live elsewhere. -->
    <add key="released-validation" value="../../artifacts/packages" />
    <add key="released-dynamicdata" value="../../artifacts/dependencies" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="released-validation"><package pattern="Runic.ReactiveUI.Validation*" /></packageSource>
    <packageSource key="released-dynamicdata"><package pattern="Runic.DynamicData*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
