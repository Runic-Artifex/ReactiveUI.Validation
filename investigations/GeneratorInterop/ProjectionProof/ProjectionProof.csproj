<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>ProjectionProof.$(Flavor)</AssemblyName></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    <PackageReference Include="ReactiveUI.SourceGenerators" Version="4.2.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(Flavor)' == 'Primitives'">
    <PackageReference Include="Runic.ReactiveUI.Validation" Version="$(ValidationVersion)" />
    <PackageReference Include="Runic.DynamicData" Version="10.0.0-runic.5" />
    <PackageReference Include="ReactiveUI" Version="26.0.1" />
    <PackageReference Include="ReactiveUI.Binding" Version="9.1.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(Flavor)' == 'Reactive'">
    <PackageReference Include="Runic.ReactiveUI.Validation.Reactive" Version="$(ValidationVersion)" />
    <PackageReference Include="Runic.DynamicData.Reactive" Version="10.0.0-runic.5" />
    <PackageReference Include="ReactiveUI.Reactive" Version="26.0.1" />
    <PackageReference Include="ReactiveUI.Binding.Reactive" Version="9.1.0" />
  </ItemGroup>
</Project>
