<Project>
  <PropertyGroup>
    <Flavor Condition="'$(Flavor)' == ''">Primitives</Flavor>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <BaseIntermediateOutputPath>obj/$(Flavor)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(Flavor)/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**;evidence/**;reproductions/**</DefaultItemExcludes>
    <ValidationVersion>8.1.0-runic.0.790.17.15.10</ValidationVersion>
  </PropertyGroup>
</Project>
